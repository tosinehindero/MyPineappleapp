rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is verified
    function isVerified() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'verified';
    }
    
    // Helper function to check if user is viewing their own profile
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Members/Profiles Collection
    match /members/{userId} {
      // Read access: Authenticated users can read
      // BUT: Application logic will filter fields based on verification
      allow read: if isAuthenticated();
      
      // Write access: Only owner can update their own profile
      allow update: if isOwner(userId) && 
                      // Only allow updating specific fields
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['description', 'fantasies', 'updatedAt', 'photoUrls', 
                                 'interests', 'lookingFor', 'location', 'ageRangeMin', 'ageRangeMax']);
      
      // Create: Can only create own profile during registration
      allow create: if isOwner(userId);
      
      // Delete: Cannot delete profiles (admin only)
      allow delete: if false;
    }
    
    // Conversations Collection
    match /conversations/{conversationId} {
      // Only participants can access
      allow read, write: if isAuthenticated() && 
                            request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated();
    }
    
    // Messages Collection (Encrypted)
    match /messages/{messageId} {
      // All authenticated users can read messages
      // (They're encrypted, so only those with keys can decrypt)
      allow read: if isAuthenticated();
      
      // Users can send messages
      allow create: if isAuthenticated() && 
                      request.resource.data.senderId == request.auth.uid;
      
      // Users can update read status
      allow update: if isAuthenticated();
      
      // Cannot delete messages
      allow delete: if false;
    }
    
    // Conversation Keys Collection (Encrypted)
    match /conversationKeys/{keyId} {
      // Only the key owner can read their encrypted key
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Keys can be created during conversation initialization
      allow create: if isAuthenticated();
      
      // Cannot update or delete keys
      allow update, delete: if false;
    }
    
    // Favorites Collection
    match /favorites/{favoriteId} {
      // Users can read their own favorites
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Users can create their own favorites
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own favorites
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
      
      // Cannot update favorites
      allow update: if false;
    }
    
    // Verification Requests (Optional - for admin approval)
    match /verificationRequests/{requestId} {
      // Users can read their own requests
      allow read: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid;
      
      // Users can create verification requests
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Only admins can update (approve/reject)
      allow update: if false; // Set to admin check in production
      
      // Cannot delete requests
      allow delete: if false;
    }
  }
}
